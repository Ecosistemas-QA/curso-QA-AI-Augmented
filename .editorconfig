# ─────────────────────────────────────────────────────────────
#  .editorconfig — normaliza cómo escriben los editores
#
#  Lo entienden VS Code, Visual Studio, IntelliJ y la mayoría de
#  los editores modernos, algunos con una extensión. No hay que
#  configurar nada a mano.
#
#  Existe por el mismo motivo que .gitattributes, pero del otro
#  lado: .gitattributes arregla los finales de línea cuando el
#  archivo entra a Git; esto los arregla antes, mientras escribís.
#
#  Importa en un repositorio de documentos: si cada uno guarda con
#  una codificación distinta, las tildes y las eñes se rompen, y
#  si cambian los finales de línea el diff marca el archivo entero
#  como modificado y nadie puede revisar qué cambió de verdad.
# ─────────────────────────────────────────────────────────────

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# En Markdown, dos espacios al final de una línea son un salto de
# línea intencional. Si el editor los borra, se rompe el formato.
[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

# Los .bat y .ps1 de Windows esperan CRLF.
[*.{bat,cmd,ps1}]
end_of_line = crlf
